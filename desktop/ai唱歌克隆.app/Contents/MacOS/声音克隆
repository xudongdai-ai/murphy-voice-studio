#!/bin/bash
set -u

APP_DIR="$HOME/pinokio/api/applio.git/app"
PYTHON_BIN="$APP_DIR/env/bin/python"
APP_URL="http://127.0.0.1:6969"
LOG_FILE="$HOME/Library/Logs/ai唱歌克隆.log"
export PATH="$HOME/pinokio/bin/miniconda/bin:/opt/homebrew/bin:$PATH"
export PYTORCH_ENABLE_MPS_FALLBACK=1
export NO_PROXY="${NO_PROXY:-},localhost,127.0.0.1"
export no_proxy="$NO_PROXY"

if /usr/bin/curl --silent --fail --max-time 2 "$APP_URL/" >/dev/null 2>&1; then
    /usr/bin/open "$APP_URL"
    exit 0
fi

if [ ! -x "$PYTHON_BIN" ] || [ ! -f "$APP_DIR/app.py" ]; then
    /usr/bin/osascript -e 'display alert "ai唱歌克隆启动失败" message "找不到项目或 Python 环境，请查看源码包中的启动说明。" as critical'
    exit 1
fi

mkdir -p "$(dirname "$LOG_FILE")"
cd "$APP_DIR" || exit 1
nohup "$PYTHON_BIN" -u app.py >"$LOG_FILE" 2>&1 &
SERVER_PID=$!

for _ in $(seq 1 60); do
    if /usr/bin/curl --silent --fail --max-time 1 "$APP_URL/" >/dev/null 2>&1; then
        /usr/bin/open "$APP_URL"
        exit 0
    fi
    if ! kill -0 "$SERVER_PID" 2>/dev/null; then
        /usr/bin/osascript -e 'display alert "ai唱歌克隆启动失败" message "服务未能启动，请查看 ~/Library/Logs/ai唱歌克隆.log。" as critical'
        exit 1
    fi
    sleep 1
done

/usr/bin/osascript -e 'display alert "ai唱歌克隆仍在启动" message "启动超过 60 秒，请查看 ~/Library/Logs/ai唱歌克隆.log 后重试。"'
exit 1
